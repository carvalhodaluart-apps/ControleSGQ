{
  "name": "criador-procedimentos",
  "version": "1.0.0",
  "private": true,
  "author": "Controle SGQ",
  "description": "Webapp para criar procedimentos internos e exportar PDF/JSON.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node backend/server.js",
    "start:local": "node scripts/start-local.js",
    "dev": "node backend/server.js",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win",
    "check": "node scripts/check-file-size.js && node scripts/check-js-syntax.js && node scripts/security-check.js",
    "import:master": "node scripts/import-master-list.js",
    "backup:db": "node scripts/backup-database.js",
    "restore:db": "node scripts/restore-database.js"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "br.com.controlesgq.app",
    "productName": "Controle SGQ",
    "icon": "electron/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/**/*",
      "package.json",
      ".env.example"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*",
      "node_modules/sql.js/**/*"
    ],
    "extraResources": [
      {
        "from": ".env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Controle SGQ",
      "uninstallDisplayName": "Controle SGQ",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@cspell/dict-pt-br": "^2.4.2",
    "cspell-lib": "^10.0.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
